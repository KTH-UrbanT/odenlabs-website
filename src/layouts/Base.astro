---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
import { assertContentIntegrity } from "../lib/content-integrity";

interface Props {
  title: string;
  description?: string;
  /** Keep the page out of search results (the not-found page). */
  noindex?: boolean;
}

await assertContentIntegrity();

const { title, description, noindex = false } = Astro.props;
const siteName = "Oden Lab";
const fullTitle = title === siteName ? title : `${title} · ${siteName}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" type="image/png" href="/icon.png" />
    {noindex ? (
      <meta name="robots" content="noindex" />
    ) : (
      <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    )}
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
