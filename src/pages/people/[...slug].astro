---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Person from "../../components/Person.astro";
import { getVisible } from "../../lib/visible";

// One page, no profile pages: each person's bio sits next to the name. The
// page exists only while there are people to show.
export async function getStaticPaths() {
  const people = await getVisible("people");
  return people.length === 0 ? [] : [{ params: { slug: undefined } }];
}

const people = await Promise.all(
  (await getVisible("people"))
    .sort(
      (a, b) =>
        a.data.order - b.data.order || a.data.name.localeCompare(b.data.name),
    )
    .map(async (person) => ({
      person,
      Content: (await render(person)).Content,
    })),
);
const current = people.filter(({ person }) => !person.data.alumni);
const alumni = people.filter(({ person }) => person.data.alumni);
---

<Base title="People" description="The members of the group.">
  <h1>People</h1>
  {current.map(({ person, Content }) => (
    <Person
      id={person.id}
      name={person.data.name}
      role={person.data.role}
      email={person.data.email}
      links={person.data.links}
      draft={person.data.draft}
    >
      <Content />
    </Person>
  ))}
  {alumni.length > 0 && <h2 class="group">Alumni</h2>}
  {alumni.map(({ person, Content }) => (
    <Person
      id={person.id}
      name={person.data.name}
      role={person.data.role}
      email={person.data.email}
      links={person.data.links}
      draft={person.data.draft}
    >
      <Content />
    </Person>
  ))}
</Base>

<style>
  .group {
    margin-top: var(--space-12);
  }
</style>
