---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { Image } from "astro:assets";
import GalleryCard from "../../components/GalleryCard.astro";
import DraftBadge from "../../components/DraftBadge.astro";
import Related from "../../components/Related.astro";
import { compareBySurname } from "../../lib/people";
import { getVisible } from "../../lib/visible";

// The section and its pages exist only while there are projects to show.
export async function getStaticPaths() {
  const projects = await getVisible("projects");
  if (projects.length === 0) return [];
  return [
    { params: { slug: undefined } },
    ...projects.map((project) => ({ params: { slug: project.id } })),
  ];
}

const { slug } = Astro.params;
if (!slug) {
  const missing = (await getVisible("projects")).filter((p) => !p.data.image);
  if (missing.length > 0) {
    console.warn(
      `[projects] ${missing.length} without a gallery image: ${missing.map((p) => p.id).join(", ")}`,
    );
  }
}
const projects = (await getVisible("projects")).sort((a, b) =>
  a.data.title.localeCompare(b.data.title),
);
const project = slug ? projects.find((p) => p.id === slug) : undefined;
const Content = project ? (await render(project)).Content : undefined;

const month = (date?: Date) =>
  date?.toLocaleDateString("en-GB", {
    year: "numeric",
    month: "long",
    timeZone: "UTC",
  });
const period = project
  ? [month(project.data.start), month(project.data.end)]
      .filter(Boolean)
      .join(" to ")
  : "";

const themes = (await getVisible("themes")).filter((t) =>
  project?.data.themes.some((ref) => ref.id === t.id),
);
const people = (await getVisible("people"))
  .filter((p) => project?.data.people.some((ref) => ref.id === p.id))
  .sort((a, b) => compareBySurname(a.data.name, b.data.name));
---

{project && Content ? (
  <Base title={project.data.title} description={project.data.summary}>
    <h1>
      {project.data.title} {project.data.draft && <DraftBadge />}
    </h1>
    <p class="lead">{project.data.summary}</p>
    {project.data.image && (
      <Image
        class="hero"
        src={project.data.image}
        alt={project.data.imageAlt ?? ""}
        width={1200}
        height={675}
        loading="eager"
      />
    )}
    <dl>
      {project.data.funder && (
        <>
          <dt>Funder</dt>
          <dd>{project.data.funder}</dd>
        </>
      )}
      {period && (
        <>
          <dt>Period</dt>
          <dd>{period}</dd>
        </>
      )}
      {project.data.url && (
        <>
          <dt>Project page</dt>
          <dd>
            <a href={project.data.url}>{project.data.url}</a>
          </dd>
        </>
      )}
    </dl>
    <Content />
    <Related
      heading="Research themes"
      items={themes.map((t) => ({
        href: `/research/${t.id}/`,
        label: t.data.title,
        draft: t.data.draft,
      }))}
    />
    <Related
      heading="People"
      items={people.map((p) => ({
        href: `/people/#${p.id}`,
        label: p.data.name,
        draft: p.data.draft,
      }))}
    />
  </Base>
) : (
  <Base title="Projects" description="The projects of the group.">
    <h1>Projects</h1>
    <div class="gallery">
      {projects.map((p) => (
        <GalleryCard
          href={`/projects/${p.id}/`}
          title={p.data.title}
          meta={p.data.funder}
          summary={p.data.summary}
          image={p.data.image}
          alt={p.data.imageAlt}
          draft={p.data.draft}
        />
      ))}
    </div>
  </Base>
)}

<style>
  .gallery {
    display: grid;
    gap: var(--space-8) var(--space-6);
    grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
    margin-top: var(--space-6);
  }
  .hero {
    display: block;
    width: 100%;
    height: auto;
    margin: var(--space-4) 0 var(--space-6);
  }
  .lead {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
  }
  dt {
    font-weight: var(--weight-bold);
  }
  dd {
    margin: 0 0 var(--space-3);
  }
</style>
