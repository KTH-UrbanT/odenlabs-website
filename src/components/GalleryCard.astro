---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import DraftBadge from "./DraftBadge.astro";

interface Props {
  href: string;
  title: string;
  summary?: string;
  /** A short line under the title (a funder). */
  meta?: string;
  image?: ImageMetadata;
  /** Required with `image`: describes the picture for readers who cannot see it. */
  alt?: string;
  draft?: boolean;
}

const {
  href,
  title,
  summary,
  meta,
  image,
  alt = "",
  draft = false,
} = Astro.props;
---

<article>
  <a class="thumb" href={href} tabindex="-1" aria-hidden="true">
    {image ? (
      <Image src={image} alt={alt} width={800} height={600} loading="lazy" />
    ) : (
      <span class="placeholder"></span>
    )}
  </a>
  <h2>
    <a href={href}>{title}</a> {draft && <DraftBadge />}
  </h2>
  {meta && <p class="meta">{meta}</p>}
  {summary && <p>{summary}</p>}
</article>

<style>
  .thumb {
    display: block;
    aspect-ratio: 4 / 3;
    margin-bottom: var(--space-3);
    overflow: hidden;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
  }
  .thumb :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .placeholder {
    display: block;
    width: 100%;
    height: 100%;
  }
  h2 {
    margin: 0 0 var(--space-2);
    font-size: var(--text-xl);
  }
  p {
    margin: 0 0 var(--space-2);
  }
  .meta {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }
</style>
